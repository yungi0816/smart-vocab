NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Use a local path for development. Do not commit the real database file.
DB_PATH=./data/vocab.db

# Change these values before running outside local development.
JWT_SECRET=change-this-local-jwt-secret
ADMIN_KEY=change-this-local-admin-key

# Optional tutor integration.
AI_API_KEY=
AI_API_URL=https://models.inference.ai.azure.com
AI_MODEL=gpt-4.1
GITHUB_CLIENT_ID=
AI_TOKEN_PATH=./data/ai_token.json

# Optional path used when serving a built Flutter web app.
WEB_APP_ROOT=../mobile/build/web
